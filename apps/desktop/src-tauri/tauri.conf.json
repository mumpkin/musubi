{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Musubi",
	"version": "0.4.0",
	"identifier": "io.github.mumpkin.musubi",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Musubi",
				"width": 1200,
				"height": 800,
				"decorations": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["appimage", "deb"],
		"publisher": "mumpkin",
		"homepage": "https://github.com/mumpkin/musubi",
		"license": "GPL-3.0-or-later",
		"category": "Productivity",
		"shortDescription": "Local-first notes written in Typst, edited the Helix way",
		"longDescription": "Musubi keeps notes as Typst files in a folder you sync as you like, shows them in a native reading view, and edits them with Helix-style modal editing. Links, backlinks, a graph and flashcards.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png"
		]
	}
}
