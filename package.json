{
	"name": "musubi",
	"version": "0.3.0",
	"private": true,
	"description": "Local-first notes written in Typst, edited the Helix way",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @musubi/desktop dev",
		"dev:tauri": "pnpm --filter @musubi/desktop tauri dev",
		"build:tauri": "pnpm --filter @musubi/desktop tauri build",
		"check": "eslint . && prettier --check \"**/*.{json,jsonc,yml,yaml,md}\" && node tools/check-file-length.ts",
		"fix": "eslint . --fix && prettier --write \"**/*.{json,jsonc,yml,yaml,md}\"",
		"typecheck": "pnpm --recursive typecheck && tsc --project tools/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"duplicates": "jscpd",
		"test:typst": "node tools/typst/check-typst-package.ts",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-svelte": "^3.24.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"jscpd": "^5.4.3",
		"lefthook": "^2.2.2",
		"prettier": "^3.9.10",
		"svelte": "^5.57.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
